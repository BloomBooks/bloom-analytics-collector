# Copy to .env and fill in. .env is gitignored -- never commit real values.

# ---------------------------------------------------------------- Mixpanel ----
# Create a service account: Mixpanel -> Organization Settings -> Service Accounts.
# Give it at least Consumer access to all three Bloom projects.
MIXPANEL_SERVICE_ACCOUNT_USER=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
# Only if a project is in the EU/India data region. This is the RAW EXPORT host,
# which is the only Mixpanel endpoint the tool calls:
# MIXPANEL_DATA_HOST=https://data-eu.mixpanel.com

# Project ids are NOT secrets and live in config/mixpanel-projects.json.
# Set MIXPANEL_PROJECT_ID_BLOOM_EDITOR / _BLOOM_READER_RELEASE / _BLOOM_LIBRARY
# here only to override that config for a one-off run.

# ------------------------------------------------------------- Google Play ----
# The bulk-reports bucket, which holds the monthly install CSVs. A Play Console
# admin must first add the service account under Users and permissions -> Invite
# new user, with "View app information" set to GLOBAL (account-level); an
# app-scoped grant does not reach the bulk reports. Get the bucket from Play
# Console -> Download reports -> "Copy Cloud Storage URI"; it is the
# pubsite_prod_* part.
PLAY_REPORTS_BUCKET=
# Which CSV column counts as an install. The default is Play's uniques-based
# measure, matching the dashboard's "Unique first-run" definition. Only change it
# if that definition changes.
# PLAY_INSTALL_COLUMN=Daily Device Installs

# ------------------------------------------------------------------ Google ----
# Service-account JSON for reading the Play reports bucket. The bucket is owned by
# Google Play, not by your GCP project, so no Cloud Console IAM role grants access
# -- see the PLAY_REPORTS_BUCKET note above. Keep the file OUTSIDE this repo.
# Nothing here touches Google Sheets.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\bloom-metrics-service-account.json

# ------------------------------------------------------------------ GitHub ----
# Optional; only raises the API rate limit. A classic token with no scopes is
# enough for public repos.
GITHUB_TOKEN=
